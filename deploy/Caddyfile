# 主機名稱都由 Caddy 自動申請、續期 Let's Encrypt 憑證
# DNS（Cloudflare，灰雲）：voice / relay / gvg 三筆 A 紀錄指向本機固定 IP

voice.xiaoyu0708.ip-ddns.com {
	root * /srv/web
	# wasm 約 3 MB，壓縮後約 1 MB
	encode zstd gzip
	# 每次都向伺服器確認有沒有新版（有 ETag，沒變只回 304），部署後大家馬上拿到新版
	header Cache-Control "no-cache"
	file_server
}

gvg.xiaoyu0708.ip-ddns.com {
	# 百業戰語音機器人（另一個 docker compose 專案，埠 8766 發佈在本機）
	reverse_proxy host.docker.internal:8766
}

modhelmx.xiaoyu0708.ip-ddns.com {
	# ModHelmX Web 後台跑在樹莓派（區網 192.168.0.4:8001），這裡只負責 HTTPS
	reverse_proxy 192.168.0.4:8001
}

relay.xiaoyu0708.ip-ddns.com {
	# iroh-relay 在設定了 TLS（為了 QAD）時，relay 服務只跑在它自己的 HTTPS 埠，
	# 所以這裡以 HTTPS 轉給它；它用的憑證就是 Caddy 這個主機名稱的憑證
	reverse_proxy https://iroh-relay:8443 {
		transport http {
			tls_server_name relay.xiaoyu0708.ip-ddns.com
			# 不保留閒置的上游連線：iroh-relay 規定每條連線要在接受後 30 秒內升級成 relay 連線
			# （ESTABLISH_TIMEOUT，不會因為有流量而重算），否則記一筆 ERROR
			# 「Connection did not reach established state within timeout」。
			# 客戶端測延遲的 /ping 等一般請求若共用 Caddy 留著的連線，30 秒後就會被這樣切掉。
			# WebSocket（/relay）升級後是獨立的長連線，不受影響
			keepalive off
		}
	}
}
