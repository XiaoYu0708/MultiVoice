# 兩個主機名稱都由 Caddy 自動申請、續期 Let's Encrypt 憑證
# DNS（Cloudflare，灰雲）：voice / relay 兩筆 A 紀錄指向本機固定 IP

voice.xiaoyu0708.ip-ddns.com {
	root * /srv/web
	file_server
}

relay.xiaoyu0708.ip-ddns.com {
	# iroh-relay 在設定了 TLS（為了 QAD）時，relay 服務只跑在它自己的 HTTPS 埠，
	# 所以這裡以 HTTPS 轉給它；它用的憑證就是 Caddy 這個主機名稱的憑證
	reverse_proxy https://iroh-relay:8443 {
		transport http {
			tls_server_name relay.xiaoyu0708.ip-ddns.com
		}
	}
}
